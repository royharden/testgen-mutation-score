{
  // CLI, scripts and tests (Node 20+, ESM). NodeNext resolution: relative imports carry `.js` suffixes
  // that resolve to the `.ts` sources (tsx and vitest resolve them the same way at activation).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["cli", "scripts", "tests", "vitest.config.ts", "vite.config.ts"],
  "exclude": ["fixtures", "approved", "node_modules", "dist"]
}
